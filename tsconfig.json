{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["src", "tests/**/*.ts", ".changeset/**/*.ts", "*.config.ts"],
  "exclude": ["tests/fixtures"]
}
